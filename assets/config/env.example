# Credentials for a local build. Copy to `assets/config/env` and fill in.
#
# A CI build passes these as --dart-define instead and needs no such file;
# the defines win when both are present.
#
# API_ID/API_HASH: your own pair from https://my.telegram.org — an official
# application's id makes Telegram demand an app verification token that only
# that application can produce, and no sign-in can complete.
API_ID=
API_HASH=
# Any non-empty string. Changing it makes databases already on the device
# unreadable, which signs every account out.
DB_ENCRYPTION_KEY=
